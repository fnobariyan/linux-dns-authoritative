# Bind Configurations

cp /etc/named.conf ~/named.conf-14040510
vim /etc/named.conf

# Add forwarders as acl
acl "forwarders" {
        127.0.0.1;
        192.168.56.103;
};

options {
        listen-on port 53 { 192.168.56.102; };
        listen-on-v6 port 53 { none; };
        directory       "/var/named";
        dump-file       "/var/named/data/cache_dump.db";
        statistics-file "/var/named/data/named_stats.txt";
        memstatistics-file "/var/named/data/named_mem_stats.txt";
        secroots-file   "/var/named/data/named.secroots";
        recursing-file  "/var/named/data/named.recursing";
        allow-query     { forwarders; };

        # Hide version for security
        version" ";


	recursion no;
	dnssec-validation no;
# Creat key and then put it here (tsig-keygen -a HMAC-sha512 dnskey)

key "dnskey" {
        algorithm hmac-sha512;
        secret "etVLqUcsIt0y8PxHptLWsj9S600aavTjEuZK0LJeAKp6gxokIb0kuIzUWHybvyl0SmChrAKdzj4mozBUkvGNOw==";
};

# Creating Forward Dns zone
zone "mcloud.local" {
        type master;
        file "/etc/named/zones/db.mcloud.local";
        allow-transfer { key "dnskey"; };
        notify yes;
        also-notify { 192.168.56.104; };
};
# Creating Reverse DNS zone
zone "56.168.192.in-addr.arpa" {
        type master;
        file "/etc/named/zones/db.56.168.192.in-addr.arpa";
};
