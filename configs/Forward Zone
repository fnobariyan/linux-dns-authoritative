# Create Zone File

mkdir /etc/named/zones

chown root:named /etc/named/zones

chmod g+s /etc/named/zones

cp /var/named/named.empty /etc/named/zones/db.mcloud.local

vim /etc/named/zones/db.mcloud.local
$TTL 3H
@       IN SOA  @ rname.invalid. (
                                        3       ; serial
                                        1D      ; refresh
                                        1H      ; retry
                                        1W      ; expire
                                        3H )    ; minimum
        NS      ns1.mcloud.local.
        A       192.168.56.102
ns1     A       192.168.56.102
www     A       192.168.56.162
lms     A       192.168.56.171
w       CNAME   www.mcloud.local.
ww      CNAME   www.mcloud.local.

